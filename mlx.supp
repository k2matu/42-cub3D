{
	leak mlx
	Memcheck:Leak
	...
	fun:*dlopen*
}

{
   glibc_dlopen
   Memcheck:Leak
   fun:malloc
   obj:/usr/libexec/valgrind/vgpreload_memcheck-arm64-linux.so
   fun:add_to_global_resize
   fun:dl_open_worker_begin
   fun:_dl_catch_exception
   fun:dl_open_worker
   fun:_dl_open
   ...
}

{
   libX11_malloc_1
   Memcheck:Leak
   fun:malloc
   obj:/usr/lib/aarch64-linux-gnu/libX11.so*
}

{
   libX11_calloc
   Memcheck:Leak
   fun:calloc
   obj:/usr/lib/aarch64-linux-gnu/libX11.so*
}

{
   libX11_strdup
   Memcheck:Leak
   fun:strdup
   obj:/usr/lib/aarch64-linux-gnu/libX11.so*
}

{
   llvm_leak_1
   Memcheck:Leak
   fun:operator new(unsigned long, std::align_val_t)
   obj:/usr/lib/aarch64-linux-gnu/libLLVM-*.so.*
   ...
}

{
   llvm_leak_2
   Memcheck:Leak
   fun:llvm::cl::Option::addArgument
   obj:/usr/lib/aarch64-linux-gnu/libLLVM-*.so.*
   ...
}

{
   llvm_leak_3
